# Copy this file to .env and fill in real values. .env is already gitignored.

# Required for the VirusTotal Deep Scan feature (/scan/deep, /add_to_whitelist
# flows that classify a target, etc.). Without it, deep-scan requests return
# {"ok": false, "message": "Missing API key..."} but everything else still works.
VIRUSTOTAL_API_KEY=

# Optional: set to "true" to log every SQL statement the backend runs (verbose).
SQL_ECHO=false
